# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Login code channels, first is the default: "sms", or "whatsapp,sms" once WhatsApp is set up
EXPO_PUBLIC_OTP_CHANNELS=sms
